rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks are seeded by the seed script (content fields) or toggled by the
    // dashboard UI (done/approval). No create/delete from the client — the
    // fixed set of task documents is managed entirely by editing seed data.
    match /tasks/{taskId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'done', 'approval',
        'sectionId', 'sectionTitle', 'itemId', 'order', 'title', 'subtitle',
        'how', 'priority', 'link', 'linkLabel', 'driveLink'
      ]);
      allow create, delete: if false;
    }

    // History entries are logged manually (by Ryan or a script) outside this
    // app. The dashboard only ever reads them.
    match /history/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // Cached Search Console / Analytics data, refreshed by the sync script.
    // Locked to the two known dashboard doc IDs so the client can't create
    // arbitrary documents in this collection.
    match /tracking/{dashboardId} {
      allow read: if true;
      allow write: if dashboardId in ['airway', 'marpe'];
    }
  }
}
